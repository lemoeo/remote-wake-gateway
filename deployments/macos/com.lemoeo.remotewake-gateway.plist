<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lemoeo.remotewake-gateway</string>
    <!-- Replace UserName with an existing local account before loading. -->
    <key>UserName</key>
    <string>remotewake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/remotewake-gateway</string>
        <string>serve</string>
        <string>--data-dir</string>
        <string>/usr/local/var/lib/remotewake-gateway</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/lib/remotewake-gateway</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>15</integer>
    <!-- Decimal 63 is octal 0077. -->
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/remotewake-gateway/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/remotewake-gateway/stderr.log</string>
</dict>
</plist>
