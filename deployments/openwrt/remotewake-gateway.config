# Install as /etc/config/remotewake-gateway.
config gateway 'main'
	option enabled '1'
	# Persistent storage; do not use OpenWrt's volatile /tmp or /var.
	option data_dir '/etc/remotewake-gateway'
	# Empty: use listen from data_dir/config.json (initially 127.0.0.1:9000).
	# A nonempty value overrides the Web setting on every service start.
	option listen ''
