#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/remotewake-gateway

start_service() {
	local enabled data_dir listen
	config_load remotewake-gateway
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get data_dir main data_dir /etc/remotewake-gateway
	config_get listen main listen ''

	[ -x "$PROG" ] || {
		echo "RemoteWake Gateway: executable not found: $PROG" >&2
		return 1
	}
	case "$data_dir" in
		/*) ;;
		*) echo 'RemoteWake Gateway: data_dir must be an absolute path' >&2; return 1 ;;
	esac
	[ "$data_dir" != / ] || {
		echo 'RemoteWake Gateway: data_dir must not be /' >&2
		return 1
	}
	umask 077
	mkdir -p "$data_dir" || return 1
	chmod 700 "$data_dir" || return 1

	procd_open_instance main
	procd_set_param command "$PROG" serve --data-dir "$data_dir"
	[ -z "$listen" ] || procd_append_param command --listen "$listen"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/remotewake-gateway "$data_dir/config.json"
	procd_close_instance
}
